# =============================================================================
# AutoRAG: Cluster & Pipeline API
# =============================================================================
RHOAI_URL=
RHOAI_KFP_URL=
RHOAI_TOKEN=
RHOAI_PROJECT_NAME=
KFP_VERIFY_SSL=true
S3_SSL_VERIFY=true
# RHOAI_CREATE_DSPA=false

RHOAI_TEST_S3_SECRET_NAME=s3-connection
# RHOAI_SKIP_S3_SECRET_SETUP=true
# RHOAI_S3_SECRET_OVERWRITE_KEYS=true

# =============================================================================
# AutoRAG: Managed pipelines & DSPA (default when RHOAI_KFP_URL is unset)
# =============================================================================
RHOAI_MANAGED_PIPELINE_AUTORAG=documents-rag-optimization-pipeline
RHOAI_MANAGED_PIPELINE_AUTORAG_INDEXING=documents-indexing-pipeline
RHOAI_MANAGED_PIPELINE_WAIT_TIMEOUT=300
RHOAI_DSPA_NAME=dspa
RHOAI_DSPA_DSP_VERSION=v2
# RHOAI_DSPA_MANAGED_PIPELINES_IMAGE=quay.io/rhoai/odh-pipelines-components-rhel9@sha256:...
# RHOAI_DSPA_READY_WAIT_TIMEOUT=600
# RHOAI_DSPA_ROUTE_WAIT_TIMEOUT=300
# RHOAI_USE_MANAGED_PIPELINES=false

# =============================================================================
# AutoRAG: Pipeline & parameters
# =============================================================================
AUTORAG_PIPELINE_PATH=
AUTORAG_INDEXING_PIPELINE_PATH=
# Source of the pipeline IR in package/download mode. Point these at the branch/repo
# that carries the MaaS pipeline until it merges into the default ref.
# RHOAI_PIPELINES_COMPONENTS_REPO=red-hat-data-services/pipelines-components
# RHOAI_PIPELINES_COMPONENTS_REF=
# Set to true to upload datasets from autox_tests/autorag/data/ to S3 before tests run.
# When unset (default), datasets are assumed to already be present in S3.
AUTORAG_UPLOAD_TEST_DATASETS=false
AUTORAG_FUNCTIONAL_TEST_KEEP_ARTIFACTS=false
TEST_DATA_SECRET_NAME=
TEST_DATA_BUCKET_NAME=
INPUT_DATA_BUCKET_NAME=
INPUT_DATA_SECRET_NAME=
# MaaS inference secret (keys: MAAS_BASE_URL, MAAS_API_KEY)
MAAS_SECRET_NAME=
# Vector database secret; backend auto-detected from key prefixes
# (Milvus: MILVUS_URI[/MILVUS_TOKEN/MILVUS_SERVER_CERT]; PGVector: PGVECTOR_HOST/PORT/DB/USER/PASSWORD)
VECTOR_DB_SECRET_NAME=

# =============================================================================
# AutoRAG: S3 for artifact validation
# =============================================================================
ARTIFACTS_AWS_ACCESS_KEY_ID=
ARTIFACTS_AWS_SECRET_ACCESS_KEY=
ARTIFACTS_AWS_S3_ENDPOINT=
ARTIFACTS_AWS_DEFAULT_REGION=us-east-1
RHOAI_TEST_ARTIFACTS_BUCKET=

# =============================================================================
# AutoRAG: MaaS + vector DB credentials (for local notebook execution)
# =============================================================================
MAAS_BASE_URL=
MAAS_API_KEY=
# Vector database connection (fill in the block matching your backend).
# Milvus:
MILVUS_URI=
# MILVUS_TOKEN=
# MILVUS_SERVER_CERT=
# PGVector:
# PGVECTOR_HOST=
# PGVECTOR_PORT=5432
# PGVECTOR_DB=
# PGVECTOR_USER=
# PGVECTOR_PASSWORD=

# =============================================================================
# AutoRAG: AWS S3 location and credentials (for notebook execution)
# =============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=
# Optional: different endpoint for the DSPA CR only (e.g. in-cluster http:// URL).
# INCLUSTER_AWS_S3_ENDPOINT=
AWS_DEFAULT_REGION=
AWS_S3_BUCKET=

# =============================================================================
# AutoRAG: Model lists (required by the MaaS pipeline)
# =============================================================================
# JSON arrays (or comma-separated) of MaaS model IDs, used by optimization configs
# that set embedding_models / generation_models to "env".
AUTORAG_EMBEDDING_MODELS=
AUTORAG_GENERATION_MODELS=
# Required for indexing pipeline positive tests (single embedding model ID served by MaaS).
AUTORAG_INDEXING_EMBEDDING_MODEL_ID=
# Optional: assert the auto-detected vector backend in indexing report checks (milvus|pgvector|chroma).
# AUTORAG_EXPECTED_VECTOR_PROVIDER=

# =============================================================================
# AutoRAG: Kubernetes API for pod log fetching
# =============================================================================
K8S_API_URL=

# =============================================================================
# Test filtering & timeouts
# =============================================================================
AUTORAG_FUNCTIONAL_TESTS_TAGS=
RHOAI_PIPELINE_RUN_TIMEOUT=3600
RHOAI_KFP_POLL_INTERVAL_SECONDS=25
