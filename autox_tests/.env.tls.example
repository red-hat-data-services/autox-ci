# Copy to autox_tests/.env.tls; run_tests.sh loads it automatically.
# Existing shell exports take precedence. No cluster runs until explicitly enabled.

# Every cluster test: verified kubeconfig, EXISTING dedicated namespace, runtime image.
AUTOX_TLS_ENABLED=false
AUTOX_TLS_NAMESPACE=autox-ca-tests
AUTOX_TLS_AUTORAG_IMAGE=quay.io/YOUR_MIRROR/odh-autorag:YOUR_TAG
# KUBECONFIG=/absolute/path/to/kubeconfig  # only for a non-default kubeconfig

# Existing S3 endpoint: credentials once, bucket once, existing non-empty object.
AWS_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1  # default
# AWS_CA_BUNDLE=/absolute/path/to/trusted-ca.pem
TLS_S3_BUCKET=
TLS_S3_KEY=
# AWS_CA_BUNDLE also supplies the default CA for databases sharing this issuer.
# S04/S05-missing skip when the endpoint is trusted without the extra CA.
# S3/Milvus wrong-host and expired cases always generate their own local endpoints,
# certificates and dummy credentials. No endpoint/CA overrides are supported.

# KFP/DSPA: reuse existing infrastructure; no namespace/DSPA creation.
AUTOX_TLS_DSPA_ENABLED=false
RHOAI_KFP_URL=
RHOAI_TOKEN=
# KFP_CA_BUNDLE=/absolute/path/to/kfp-ca.pem  # if KFP uses a private CA
MAAS_BASE_URL=
MAAS_API_KEY=
# One model list per kind, shared by DSPA and N01. DSPA uses the first model.
AUTORAG_GENERATION_MODELS='["your-generation-model"]'
AUTORAG_EMBEDDING_MODELS='["your-embedding-model"]'

# Real database probes: enable only the backend(s) to test. Use a test DB.
# Milvus CA: MILVUS_SERVER_CERT, then AWS_CA_BUNDLE.
# PGVector/Neo4j CA: <BACKEND>_CA_CERT, then AWS_CA_BUNDLE.
# Each backend CA accepts a local PEM path or inline PEM.
# MILVUS_URI=https://your-milvus
# MILVUS_TOKEN=your-token
# MILVUS_SERVER_CERT=/absolute/path/to/milvus-ca.pem
# PGVECTOR_HOST=your-postgres
# PGVECTOR_PASSWORD=your-password
# PGVECTOR_PORT=5432  # default
# PGVECTOR_DB=postgres  # default
# PGVECTOR_USER=postgres  # default
# PGVECTOR_CA_CERT=/absolute/path/to/postgres-ca.pem
# NEO4J_URI=neo4j+s://your-neo4j
# NEO4J_PASSWORD=your-password
# NEO4J_USERNAME=neo4j  # default
# NEO4J_DATABASE=neo4j  # default
# NEO4J_CA_CERT=/absolute/path/to/neo4j-ca.pem

# Optional reuse of EXISTING resources instead of local credential/CA values.
# Explicit references win; these resources are read-only and never cleaned by tests.
# AUTOX_TLS_S3_SECRET=existing-s3-secret
# MAAS_SECRET_NAME=existing-maas-secret
# AUTOX_TLS_MILVUS_SECRET=existing-milvus-secret
# AUTOX_TLS_PGVECTOR_SECRET=existing-postgres-secret
# AUTOX_TLS_NEO4J_SECRET=existing-neo4j-secret
# AUTOX_TLS_S3_CA_CONFIGMAP=existing-ca
# AUTOX_TLS_S3_CA_KEY=ca-bundle.crt  # default; same CA options for each DB
# PGVector/Neo4j bad-host/expired cases need separate real-protocol fixtures:
# AUTOX_TLS_PGVECTOR_WRONG_HOST_SECRET=existing-wrong-host-secret
# AUTOX_TLS_PGVECTOR_WRONG_HOST_CA_CONFIGMAP=existing-issuer-ca
# Use *_EXPIRED_* for expiry, and NEO4J instead of PGVECTOR for Neo4j.

# N01: opt-in product pipeline with a generated wrong MaaS CA.
AUTOX_TLS_FLOWS_ENABLED=false
# AUTOX_TLS_VECTOR_DB=milvus  # milvus/pgvector/neo4j; needed when several are configured
# N01 always uploads a bundled tiny corpus/benchmark to TLS_S3_BUCKET using the
# same S3 credentials as runtime tests, then cleans only its own unchanged uploads.
# Requires read/upload/delete permissions under autox-tls-datasets/<random-session>/.
# No manual dataset keys, separate data buckets or credential Secrets are needed.
# Uses shared managed AutoRAG resolution; for YAML mode only:
# RHOAI_USE_MANAGED_PIPELINES=false
# AUTORAG_PIPELINE_PATH=/absolute/path/to/pipeline.yaml

# Operational options with a distinct purpose; normally leave unset.
# AUTOX_TLS_TIMEOUT=900  # shared override; defaults: runtime 180s, DSPA 600s, N01 3600s
# AUTOX_TLS_REPORT_DIR=tls-results
# AUTOX_TLS_KEEP_RESOURCES=true  # retain owned Jobs/material/uploads for debugging
# Temporary DSPA/N01 credential Secrets are always cleaned.
# AUTOX_TLS_PULL_SECRET=existing-image-pull-secret  # private image registry
# AUTOX_TLS_TESTS_TAGS=s3,smoke  # normally supplied by run_tests.sh --tags
